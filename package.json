{
  "name": "malts-web",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start -H 127.0.0.1",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:backfill-slugs": "ts-node --project prisma/tsconfig.seed.json prisma/backfill-product-slugs.ts",
    "seed:hot-drinks": "ts-node --project prisma/tsconfig.seed.json prisma/seed-hot-drinks.ts",
    "db:studio": "prisma studio",
    "icons:generate": "node scripts/generate-icons.mjs",
    "menu-icon:generate": "node scripts/rasterize-nasheto-menu.mjs",
    "logo:optimize": "node scripts/optimize-malts-logo.mjs && node scripts/optimize-malts-logo-nav.mjs",
    "favicon:optimize": "node scripts/optimize-favicon-from-png.mjs",
    "pwa-icons:optimize": "node scripts/optimize-pwa-icons-from-hero.mjs",
    "assets:optimize": "npm run logo:optimize && npm run pwa-icons:optimize && npm run favicon:optimize"
  },
  "prisma": {
    "seed": "ts-node --project prisma/tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "bcryptjs": "^3.0.2",
    "browser-image-compression": "^2.0.2",
    "dotenv": "^17.2.3",
    "express-rate-limit": "^8.1.0",
    "file-type": "^21.2.0",
    "googleapis": "^148.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "next": "15.5.15",
    "next-auth": "^4.24.13",
    "next-intl": "^4.3.12",
    "pg": "^8.16.3",
    "prisma": "^6.17.1",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.4.1",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@iconify/react": "^6.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
