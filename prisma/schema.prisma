// Prisma Schema — Malts (multi-brand ready)
// Ordering system with QR codes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TENANT / BRAND
// ============================================

model Brand {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  categories            Category[]
  events                Event[]
  barTables             BarTable[]
  orders                Order[]
  waiterCalls           WaiterCall[]
  productPromotions     ProductPromotion[]
  qrCodeSettings        QRCodeSettings[]
  workingHours          WorkingHours[]
  securitySettings      SecuritySettings[]
  locationSettings      LocationSettings[]
  homepageSettings      HomepageSettings[]
  homepageOfferingCards HomepageOfferingCard[]
  menuSettings          MenuSettings[]
  promotionsUiSettings  PromotionsUiSettings?
  loadingUiSettings     LoadingUiSettings?
  appearanceSettings    BrandAppearanceSettings?
  operationalSettings   OperationalSettings?
  operationalAuditLogs  OperationalSettingsAuditLog[]
  staffTableAssignments StaffTableAssignment[]

  @@map("brands")
}

// ============================================
// MENU SYSTEM
// ============================================

model Category {
  id               String     @id @default(uuid())
  brandId          String     @map("brand_id")
  brand            Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  nameBg           String     @map("name_bg")
  nameEn           String     @map("name_en")
  nameRo           String     @map("name_ro")
  slug             String
  order            Int        @default(0)
  parentCategoryId String?    @map("parent_category_id")
  parentCategory   Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: Cascade)
  subCategories    Category[] @relation("CategoryHierarchy")
  products         Product[]
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@unique([brandId, slug])
  @@index([parentCategoryId])
  @@index([brandId])
  @@map("categories")
}

model Product {
  id            String              @id @default(uuid())
  slug          String              @map("slug")
  categoryId    String              @map("category_id")
  category      Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  nameBg        String              @map("name_bg")
  nameEn        String              @map("name_en")
  nameRo        String              @map("name_ro")
  descriptionBg String?             @map("description_bg")
  descriptionEn String?             @map("description_en")
  descriptionRo String?             @map("description_ro")
  allergensBg   String?             @map("allergens_bg") @db.Text
  allergensEn   String?             @map("allergens_en") @db.Text
  allergensRo   String?             @map("allergens_ro") @db.Text
  priceBgn      Decimal             @map("price_bgn") @db.Decimal(10, 2)
  priceEur      Decimal             @map("price_eur") @db.Decimal(10, 2)
  imageUrl      String?             @map("image_url")
  unit          String              @default("pcs") @map("unit")
  quantity      Int                 @default(1) @map("quantity")
  /// JSON array of variant options (simple strings or objects). For now we store strings like ["портокал","кайсия"].
  variants      Json                @default("[]") @map("variants")
  isAvailable   Boolean             @default(true) @map("is_available")
  isHidden      Boolean             @default(false) @map("is_hidden")
  isFeatured    Boolean             @default(false) @map("is_featured")
  allergens     String[]
  order         Int                 @default(0)
  orderItems    OrderItem[]
  promotions    ProductPromotion[]
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@unique([slug])
  @@index([categoryId])
  @@index([isAvailable])
  @@index([isHidden])
  @@index([isFeatured])
  @@map("products")
}

/// Scheduled promo price window; effective price = promo when now ∈ [startsAt, endsAt].
model ProductPromotion {
  id        String   @id @default(uuid())
  brandId   String   @map("brand_id")
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Int      @default(0) @map("order")
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  priceBgn  Decimal  @map("price_bgn") @db.Decimal(10, 2)
  priceEur  Decimal  @map("price_eur") @db.Decimal(10, 2)
  label     String? // optional short label e.g. "Promo"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([brandId, startsAt, endsAt])
  @@map("product_promotions")
}

model Event {
  id            String   @id @default(uuid())
  brandId       String   @map("brand_id")
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  titleBg       String   @map("title_bg")
  titleEn       String   @map("title_en")
  titleRo       String   @map("title_ro")
  descriptionBg String   @map("description_bg")
  descriptionEn String   @map("description_en")
  descriptionRo String   @map("description_ro")
  eventDate     DateTime @map("event_date")
  location      String
  locationBg    String?  @map("location_bg")
  locationEn    String?  @map("location_en")
  locationRo    String?  @map("location_ro")
  isExternal    Boolean  @default(false) @map("is_external")
  externalUrl   String?  @map("external_url")
  contactInfo   String?  @map("contact_info")
  /// Legacy single image; kept for old rows. Prefer imageCardUrl + imageDetailUrl.
  imageUrl      String?  @map("image_url")
  /// Optimized for list cards / thumbnails (smaller file after upload).
  imageCardUrl  String?  @map("image_card_url")
  /// Full hero on the single-event page.
  imageDetailUrl String? @map("image_detail_url")
  isPublished   Boolean  @default(false) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([eventDate])
  @@index([isPublished])
  @@index([brandId])
  @@map("events")
}

// ============================================
// ORDERING SYSTEM
// ============================================

model BarTable {
  id            String       @id @default(uuid())
  brandId       String       @map("brand_id")
  brand         Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  tableNumber   Int          @map("table_number")
  tableName     String?      @map("table_name")
  capacity      Int          @default(4)
  location      String       @default("indoor")
  qrCodeUrl     String?      @map("qr_code_url")
  qrCodeData    String?      @map("qr_code_data") @db.Text
  isActive      Boolean      @default(true) @map("is_active")
  redirectUrl   String?      @map("redirect_url")
  scanCount     Int          @default(0) @map("scan_count")
  lastScannedAt DateTime?    @map("last_scanned_at")
  orders        Order[]
  waiterCalls   WaiterCall[]
  qrScans       QrScan[]
  assignments   StaffTableAssignment[]
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@unique([brandId, tableNumber])
  @@index([brandId])
  @@map("bar_tables")
}

model QrScan {
  id          String   @id @default(uuid())
  tableId     String   @map("table_id")
  table       BarTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableNumber Int      @map("table_number")
  scannedAt   DateTime @default(now()) @map("scanned_at")

  @@index([tableId])
  @@index([scannedAt])
  @@index([tableNumber])
  @@map("qr_scans")
}

model Order {
  id                 String                @id @default(uuid())
  brandId            String                @map("brand_id")
  brand              Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  tableId            String?               @map("table_id")
  table              BarTable?             @relation(fields: [tableId], references: [id])
  tableNumber        Int                   @map("table_number")
  orderNumber        Int                   @map("order_number")
  status             String                @default("pending") @map("status")
  paymentMethod      String?               @map("payment_method")
  totalBgn           Decimal               @map("total_bgn") @db.Decimal(10, 2)
  totalEur           Decimal               @map("total_eur") @db.Decimal(10, 2)
  notes              String?
  customerName       String?               @map("customer_name")
  isPaid             Boolean               @default(false) @map("is_paid")
  cancellationReason String?               @map("cancellation_reason")
  items              OrderItem[]
  approval           PendingOrderApproval?
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  completedAt        DateTime?             @map("completed_at")

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([tableNumber])
  @@index([brandId])
  @@map("orders")
}

model PendingOrderApproval {
  id          String    @id @default(uuid())
  orderId     String    @unique @map("order_id")
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tableNumber Int       @map("table_number")
  orderCount  Int       @map("order_count")
  reason      String    @default("rate_limit_exceeded")
  status      String    @default("pending")
  requestedAt DateTime  @default(now()) @map("requested_at")
  reviewedAt  DateTime? @map("reviewed_at")
  reviewedBy  String?   @map("reviewed_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, requestedAt])
  @@map("pending_order_approvals")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String   @map("product_name")
  /// Optional variant label chosen by the customer (e.g. "портокал").
  variantLabel String? @map("variant_label")
  quantity    Int      @default(1)
  priceBgn    Decimal  @map("price_bgn") @db.Decimal(10, 2)
  priceEur    Decimal  @map("price_eur") @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_items")
}

model WaiterCall {
  id             String    @id @default(uuid())
  brandId        String    @map("brand_id")
  brand          Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  tableId        String?   @map("table_id")
  table          BarTable? @relation(fields: [tableId], references: [id])
  tableNumber    Int       @map("table_number")
  callType       String    @map("call_type")
  status         String    @default("pending")
  message        String?
  createdAt      DateTime  @default(now()) @map("created_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  completedAt    DateTime? @map("completed_at")

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([brandId])
  @@map("waiter_calls")
}

model TableSession {
  id          String    @id @default(uuid())
  tableNumber Int       @map("table_number")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([tableNumber])
  @@map("table_sessions")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String             @map("password_hash")
  name              String
  role              UserRole           @default(STAFF)
  canSeeAllTables   Boolean            @default(false) @map("can_see_all_tables")
  isActive          Boolean            @default(true) @map("is_active")
  createdBy         String?            @map("created_by")
  creator           User?              @relation("UserCreator", fields: [createdBy], references: [id])
  createdUsers      User[]             @relation("UserCreator")
  pushSubscriptions PushSubscription[]
  tableAssignments  StaffTableAssignment[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

/// Assign specific tables to STAFF users (many-to-many).
model StaffTableAssignment {
  id        String   @id @default(uuid())
  brandId   String   @map("brand_id")
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tableId   String   @map("table_id")
  table     BarTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, tableId])
  @@index([brandId])
  @@index([userId])
  @@index([tableId])
  @@map("staff_table_assignments")
}

model Staff {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String             @map("password_hash")
  name              String
  role              String             @default("staff")
  isActive          Boolean            @default(true) @map("is_active")
  pushSubscriptions PushSubscription[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@map("staff")
}

model HypeSyncLog {
  id        String   @id @default(uuid())
  syncType  String   @map("sync_type")
  status    String
  data      Json?
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("hype_sync_log")
}

model PushSubscription {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId    String?  @map("staff_id")
  staff      Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  deviceName String?  @map("device_name")
  userAgent  String?  @map("user_agent")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsed   DateTime @default(now()) @map("last_used")

  @@index([userId])
  @@index([staffId])
  @@index([isActive])
  @@map("push_subscriptions")
}

model QRCodeSettings {
  id        String   @id @default(uuid())
  brandId   String   @unique @map("brand_id")
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  settings  Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("qr_code_settings")
}

model WorkingHours {
  id        String   @id @default(uuid())
  brandId   String   @map("brand_id")
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  dayOfWeek Int      @map("day_of_week")
  isOpen    Boolean  @default(true) @map("is_open")
  openTime  String?  @map("open_time")
  closeTime String?  @map("close_time")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([brandId, dayOfWeek])
  @@index([brandId])
  @@map("working_hours")
}

model SecuritySettings {
  id                        String   @id @default(uuid())
  brandId                   String   @unique @map("brand_id")
  brand                     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  approvalOrderThreshold    Int      @default(5) @map("approval_order_threshold")
  approvalTimeWindowMinutes Int      @default(5) @map("approval_time_window_minutes")
  sessionDurationHours      Int      @default(3) @map("session_duration_hours")
  autoRejectMinutes         Int      @default(30) @map("auto_reject_minutes")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("security_settings")
}

model LocationSettings {
  id        String   @id @default(uuid())
  brandId   String   @unique @map("brand_id")
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  addressBg String   @map("address_bg")
  addressEn String   @map("address_en")
  addressRo String   @map("address_ro")
  latitude  Float?   @map("latitude")
  longitude Float?   @map("longitude")
  phone     String   @default("") @map("phone")
  instagramUrl String @default("") @map("instagram_url")
  facebookUrl  String @default("") @map("facebook_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("location_settings")
}

model HomepageSettings {
  id             String   @id @default(uuid())
  brandId        String   @unique @map("brand_id")
  brand          Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  sectionLabelBg String   @map("section_label_bg")
  sectionLabelEn String   @map("section_label_en")
  sectionLabelRo String   @map("section_label_ro")
  titleBg        String   @map("title_bg")
  titleEn        String   @map("title_en")
  titleRo        String   @map("title_ro")
  subtitleBg     String   @map("subtitle_bg")
  subtitleEn     String   @map("subtitle_en")
  subtitleRo     String   @map("subtitle_ro")
  descriptionBg  String   @map("description_bg") @db.Text
  descriptionEn  String   @map("description_en") @db.Text
  descriptionRo  String   @map("description_ro") @db.Text
  moodTextBg     String   @map("mood_text_bg")
  moodTextEn     String   @map("mood_text_en")
  moodTextRo     String   @map("mood_text_ro")
  offeringsNoteBg String  @default("") @map("offerings_note_bg") @db.Text
  offeringsNoteEn String  @default("") @map("offerings_note_en") @db.Text
  offeringsNoteRo String  @default("") @map("offerings_note_ro") @db.Text
  highlightsLabelBg String @default("Акценти") @map("highlights_label_bg")
  highlightsLabelEn String @default("Highlights") @map("highlights_label_en")
  highlightsLabelRo String @default("Accente") @map("highlights_label_ro")
  cardsHeadingBg String @default("") @map("cards_heading_bg")
  cardsHeadingEn String @default("") @map("cards_heading_en")
  cardsHeadingRo String @default("") @map("cards_heading_ro")
  stats          Json
  ctaPrimaryBg   String   @map("cta_primary_bg")
  ctaPrimaryEn   String   @map("cta_primary_en")
  ctaPrimaryRo   String   @map("cta_primary_ro")
  ctaSecondaryBg String   @map("cta_secondary_bg")
  ctaSecondaryEn String   @map("cta_secondary_en")
  ctaSecondaryRo String   @map("cta_secondary_ro")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("homepage_settings")
}

model PromotionsUiSettings {
  id        String   @id @default(uuid())
  brandId   String   @unique @map("brand_id")
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  titleBg   String   @default("Промоция") @map("title_bg")
  titleEn   String   @default("Promotion") @map("title_en")
  titleRo   String   @default("Promoție") @map("title_ro")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("promotions_ui_settings")
}

model HomepageOfferingCard {
  id            String   @id @default(uuid())
  brandId       String   @map("brand_id")
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  order         Int      @default(0)
  icon          String
  titleBg       String   @map("title_bg")
  titleEn       String   @map("title_en")
  titleRo       String   @map("title_ro")
  descriptionBg String   @map("description_bg") @db.Text
  descriptionEn String   @map("description_en") @db.Text
  descriptionRo String   @map("description_ro") @db.Text
  badgeBg       String   @map("badge_bg")
  badgeEn       String   @map("badge_en")
  badgeRo       String   @map("badge_ro")
  highlights    Json
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([brandId])
  @@map("homepage_offering_cards")
}

model MenuSettings {
  id                 String   @id @default(uuid())
  brandId            String   @unique @map("brand_id")
  brand              Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  titleBg            String   @map("title_bg")
  titleEn            String   @map("title_en")
  titleRo            String   @map("title_ro")
  titleColor         String?  @map("title_color")
  subtitleBg         String   @map("subtitle_bg")
  subtitleEn         String   @map("subtitle_en")
  subtitleRo         String   @map("subtitle_ro")
  subtitleColor      String?  @map("subtitle_color")
  backgroundImageUrl String?  @map("background_image_url")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("menu_settings")
}

/// Per-brand loading overlay rules/assets, managed via admin UI.
model LoadingUiSettings {
  id             String   @id @default(uuid())
  brandId         String   @unique @map("brand_id")
  brand           Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  enabled         Boolean  @default(true) @map("enabled")
  defaultAssetId  String?  @map("default_asset_id")
  /// JSON array: { id, name, url, type("image"|"video"), createdAt }
  assets          Json     @default("[]") @map("assets")
  /// JSON array: { id, path, assetId, enabled, minMs, extraMs }
  rules           Json     @default("[]") @map("rules")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("loading_ui_settings")
}

/// Per-brand appearance (theme tokens + logos). Managed via SUPER_ADMIN UI.
model BrandAppearanceSettings {
  id        String   @id @default(uuid())
  brandId   String   @unique @map("brand_id")
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  // Core theme tokens (nullable = fallback to defaults in app/globals.css)
  paper     String?  @map("paper")
  ink       String?  @map("ink")
  muted     String?  @map("muted")
  subtle    String?  @map("subtle")
  card      String?  @map("card")
  cardHover String?  @map("card_hover")
  inset     String?  @map("inset")
  hairline  String?  @map("hairline")

  accent         String? @map("accent")
  accentHover    String? @map("accent_hover")
  accentContrast String? @map("accent_contrast")

  success String? @map("success")
  warning String? @map("warning")
  danger  String? @map("danger")
  info    String? @map("info")

  // Browser / PWA UI
  themeColor String? @map("theme_color")

  // Logos / icons (URLs)
  navLogoUrl  String? @map("nav_logo_url")
  heroLogoUrl String? @map("hero_logo_url")
  appIconUrl  String? @map("app_icon_url")
  faviconUrl  String? @map("favicon_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("brand_appearance_settings")
}

/// Per-brand toggles: max QR tables, ordering, waiter call (super admin).
model OperationalSettings {
  id                String   @id @default(uuid())
  brandId           String   @unique @map("brand_id")
  brand             Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  maxQrTables       Int      @default(30) @map("max_qr_tables")
  ordersEnabled     Boolean  @default(true) @map("orders_enabled")
  waiterCallEnabled Boolean  @default(true) @map("waiter_call_enabled")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("operational_settings")
}

/// Audit trail for operational (super admin) changes.
model OperationalSettingsAuditLog {
  id         String   @id @default(uuid())
  brandId    String   @map("brand_id")
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  actorUserId String? @map("actor_user_id")
  actorEmail  String? @map("actor_email")
  action     String   @default("UPDATE")
  before     Json
  after      Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([brandId, createdAt(sort: Desc)])
  @@map("operational_settings_audit_log")
}

// ============================================
// BACKUPS (SUPER_ADMIN only)
// ============================================

/// Singleton row (id = "default") for Google Drive OAuth app credentials when not using env vars.
model BackupSettings {
  id                      String   @id @default("default")
  googleDriveClientId     String?  @map("google_drive_client_id")
  googleDriveClientSecret String?  @map("google_drive_client_secret")
  googleDriveRedirectUri  String?  @map("google_drive_redirect_uri")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("backup_settings")
}

model BackupDestination {
  id              String   @id @default(uuid())
  name            String
  type            String
  config          Json
  active          Boolean  @default(true)
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  artifacts       BackupArtifact[]

  @@index([active])
  @@index([type])
  @@map("backup_destinations")
}

model BackupPolicy {
  id              String    @id @default(uuid())
  name            String
  intervalMinutes Int       @map("interval_minutes")
  retentionDays   Int       @default(30) @map("retention_days")
  destinationIds  Json      @map("destination_ids")
  enabled         Boolean   @default(true)
  lastRunAt       DateTime? @map("last_run_at")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  jobs            BackupJob[]

  @@index([enabled])
  @@map("backup_policies")
}

model BackupJob {
  id               String    @id @default(uuid())
  triggerType       String    @map("trigger_type")
  status            String    @default("PENDING")
  policyId          String?   @map("policy_id")
  requestedByUserId String?   @map("requested_by_user_id")
  note              String?
  targetDatabaseUrl String?   @map("target_database_url")
  startedAt         DateTime? @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  error             String?
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  policy            BackupPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  artifacts         BackupArtifact[]

  @@index([status, createdAt])
  @@index([policyId])
  @@map("backup_jobs")
}

model BackupArtifact {
  id             String   @id @default(uuid())
  jobId          String   @map("job_id")
  destinationId  String   @map("destination_id")
  status         String   @default("PENDING")
  filePath       String?  @map("file_path")
  checksumSha256 String?  @map("checksum_sha256")
  fileSizeBytes  BigInt?  @map("file_size_bytes")
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  job            BackupJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  destination    BackupDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([destinationId])
  @@map("backup_artifacts")
}
