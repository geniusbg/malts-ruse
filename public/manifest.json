{
  "name": "Malts",
  "short_name": "Malts",
  "description": "Malts – Русе",
  "start_url": "/bg",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "theme_color": "#e8e0d4",
  "background_color": "#e8e0d4",
  "protocol_handlers": [
    {
      "protocol": "web+malts",
      "url": "/bg/malts-protocol?target=%s"
    }
  ],
  "icons": [
    {
      "src": "/malts-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/malts-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/malts-icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}

